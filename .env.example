# PlaceMate AI & MailTrace Security Environment Template
# COPY THIS FILE TO .env AND SET YOUR PRODUCTION SECRETS

PLACEMATE_ENV=development
PLACEMATE_SECRET_KEY=change_this_to_a_32_character_random_secret_key_in_production
PLACEMATE_TOKEN_EXPIRE_MINUTES=60
PLACEMATE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
